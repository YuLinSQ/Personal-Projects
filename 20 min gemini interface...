/**
 * Gemini Local Chat — single‑file Node.js app
 * -------------------------------------------------
 * What this gives you:
 *  - A localhost website at http://localhost:3000 with a simple chat UI
 *  - A backend proxy so your GEMINI_API_KEY is NOT exposed to the browser
 *  - Uses Google Gemini 2.x/2.5 (set the model name below)
 *
 * Requirements:
 *  - Node.js v18+ (for built‑in fetch)
 *  - An environment variable GEMINI_API_KEY set to your API key
 *
 * Quick start:
 *  1) Save this file as server.js
 *  2) npm init -y && npm install express dotenv
 *  3) On mac/linux:  export GEMINI_API_KEY="YOUR_KEY"
 *     On Windows PS:  setx GEMINI_API_KEY "YOUR_KEY"  (restart terminal after)
 *  4) node server.js
 *  5) Open http://localhost:3000
 */

import express from 'express';
import dotenv from 'dotenv';
import fetch from "node-fetch";

dotenv.config();

const app = express();
const PORT = process.env.PORT || 3000;
// const GEMINI_API_KEY = process.env.GEMINI_API_KEY;
const GEMINI_API_KEY = "AIzaSyD7STRgvfsMOZHVFunaqzT-TgYebIWytJk";

if (!GEMINI_API_KEY) {
  console.error('\n[ERROR] Missing GEMINI_API_KEY environment variable.');
  console.error('        Set it then restart: export GEMINI_API_KEY="YOUR_KEY"\n');
  process.exit(1);
}

app.use(express.json({ limit: '1mb' }));

// --- Minimal static UI served from memory ---
app.get('/', (_req, res) => {
  res.setHeader('Content-Type', 'text/html; charset=utf-8');
  res.send(`
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Gemini Local Chat</title>
  <style>
    :root { font-family: system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, Arial, sans-serif; }
    body { margin: 0; background: #0b0c10; color: #eaf0f6; }
    header { padding: 16px 20px; background: #111319; border-bottom: 1px solid #1f2430; position: sticky; top: 0; z-index: 2; }
    header h1 { margin: 0; font-size: 18px; letter-spacing: 0.3px; }
    #app { max-width: 900px; margin: 0 auto; padding: 16px; display: grid; grid-template-rows: 1fr auto; gap: 12px; height: calc(100dvh - 56px); }
    #chat { overflow-y: auto; padding: 8px; display: flex; flex-direction: column; gap: 10px; }
    .msg { display: grid; grid-template-columns: 48px 1fr; gap: 10px; align-items: flex-start; }
    .avatar { width: 36px; height: 36px; border-radius: 12px; display: grid; place-items: center; font-weight: 700; background: #1f2430; color: #cdd6f4; }
    .bubble { background: #121622; border: 1px solid #23293a; padding: 12px 14px; border-radius: 14px; line-height: 1.45; white-space: pre-wrap; }
    .user .bubble { background: #0f1a2b; border-color: #203a6b; }
    .assistant .bubble { background: #121b14; border-color: #28422a; }
    .meta { font-size: 12px; color: #9aa7b2; margin-bottom: 6px; }
    .inputRow { display: grid; grid-template-columns: 1fr auto; gap: 8px; padding: 8px; background: #0f1117; border-top: 1px solid #1f2430; border-radius: 12px; }
    #prompt { resize: none; min-height: 52px; max-height: 200px; padding: 12px; border-radius: 10px; border: 1px solid #2a3142; background: #0b0e15; color: #eaf0f6; outline: none; }
    #prompt:focus { border-color: #3e8ef7; box-shadow: 0 0 0 2px #3e8ef733; }
    button { border: 1px solid #2a3142; background: #13233a; color: #eaf0f6; padding: 0 16px; border-radius: 10px; font-weight: 600; cursor: pointer; }
    button[disabled] { opacity: 0.6; cursor: not-allowed; }
    .tip { text-align: center; color: #94a3b8; font-size: 13px; margin-top: 4px; }
    a { color: #7ab3ff; }
    .small { font-size: 12px; color: #9aa7b2; }
    .spinner { width: 16px; height: 16px; border: 2px solid #2a3142; border-top-color: #7ab3ff; border-radius: 50%; animation: spin 1s linear infinite; display: inline-block; vertical-align: middle; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
  </style>
</head>
<body>
  <header><h1>Gemini Local Chat</h1></header>
  <div id="app">
    <div id="chat"></div>
    <div>
      <div class="inputRow">
        <textarea id="prompt" placeholder="Ask me anything… (Shift+Enter for newline)"></textarea>
        <button id="sendBtn">Send</button>
      </div>
      <div class="tip">Model: <span class="small code" id="modelName"></span> · Your key is stored on the server (never in the browser).</div>
    </div>
  </div>

  <script>
    const chat = document.getElementById('chat');
    const promptEl = document.getElementById('prompt');
    const sendBtn = document.getElementById('sendBtn');
    const modelNameEl = document.getElementById('modelName');

    let MODEL_NAME = 'gemini-2.5-flash'; // Keep in sync with server

    async function send() {
      const text = promptEl.value.trim();
      if (!text) return;

      addMessage('user', text);
      promptEl.value = '';
      promptEl.focus();
      setBusy(true);

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: text })
        });
        if (!res.ok) {
          const t = await res.text();
          throw new Error('HTTP ' + res.status + ': ' + t);
        }
        const data = await res.json();
        addMessage('assistant', data.text || '(no content)');
      } catch (err) {
        console.error(err);
        addMessage('assistant', '⚠️ Error: ' + err.message);
      } finally {
        setBusy(false);
      }
    }

    function addMessage(role, text) {
      const wrap = document.createElement('div');
      wrap.className = 'msg ' + role;
      const avatar = document.createElement('div');
      avatar.className = 'avatar';
      avatar.textContent = role === 'user' ? 'U' : 'G';
      const bubble = document.createElement('div');
      bubble.className = 'bubble';
      bubble.textContent = text;
      wrap.appendChild(avatar);
      const content = document.createElement('div');
      const meta = document.createElement('div');
      meta.className = 'meta';
      meta.textContent = role === 'user' ? 'You' : 'Gemini';
      content.appendChild(meta);
      content.appendChild(bubble);
      wrap.appendChild(content);
      chat.appendChild(wrap);
      chat.scrollTop = chat.scrollHeight;
    }

    function setBusy(on) {
      sendBtn.disabled = on;
      if (on) {
        sendBtn.innerHTML = '<span class="spinner"></span> Sending';
      } else {
        sendBtn.textContent = 'Send';
      }
    }

    sendBtn.addEventListener('click', send);
    promptEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        send();
      }
    });

    // Sync the model name label
    fetch('/api/meta').then(r => r.json()).then(j => {
      MODEL_NAME = j.model || MODEL_NAME;
      modelNameEl.textContent = MODEL_NAME;
    }).catch(() => { modelNameEl.textContent = MODEL_NAME; });
  </script>
</body>
</html>
  `);
});

// --- Backend chat endpoint (simple non-streaming) ---
app.post('/api/chat', async (req, res) => {
  try {
    const userText = String(req.body?.message ?? '').trim();
    if (!userText) return res.status(400).json({ error: 'Missing message' });

    const model = MODEL_NAME;

    const body = {
      contents: [
        {
          parts: [{ text: userText }]
        }
      ]
    };

    const resp = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-goog-api-key': GEMINI_API_KEY,
      },
      body: JSON.stringify(body)
    });

    if (!resp.ok) {
      const txt = await resp.text();
      return res.status(resp.status).send(txt);
    }

    const data = await resp.json();

    // Try multiple shapes defensively (API variants):
    const text =
      data?.candidates?.[0]?.content?.parts?.map(p => p.text).join('\n') ||
      data?.candidates?.[0]?.content?.parts?.[0]?.text ||
      data?.output_text ||
      '';

    return res.json({ text });
  } catch (err) {
    console.error(err);
    return res.status(500).json({ error: 'Server error', message: String(err?.message || err) });
  }
});

// --- Meta for showing which model is configured ---
const MODEL_NAME = process.env.GEMINI_MODEL || 'gemini-2.5-flash';
app.get('/api/meta', (_req, res) => {
  res.json({ model: MODEL_NAME });
});

app.listen(PORT, () => {
  console.log(`\nGemini Local Chat running at http://localhost:${PORT}`);
  console.log(`Model: ${MODEL_NAME}`);
});


