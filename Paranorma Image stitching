import cv2
import numpy as np
import os
import sys

# Compute homography using DLT
def compute_homography(src_pts, dst_pts):
    assert src_pts.shape[0] >= 4, "At least 4 points are required to compute homography."

    A = []
    for i in range(src_pts.shape[0]):
        x, y = src_pts[i][0]
        x_prime, y_prime = dst_pts[i][0]
        A.append([-x, -y, -1, 0, 0, 0, x * x_prime, y * x_prime, x_prime])
        A.append([0, 0, 0, -x, -y, -1, x * y_prime, y * y_prime, y_prime])

    A = np.array(A)
    _, _, Vt = np.linalg.svd(A)
    H = Vt[-1].reshape(3, 3)

    return H / H[2, 2]  # Normalize

# Compute homography using RANSAC
def compute_homography_ransac(src_pts, dst_pts, threshold=5.0, max_iters=2000):
    num_points = src_pts.shape[0]
    best_H = None
    best_inliers = 0

    for _ in range(max_iters):
        indices = np.random.choice(num_points, 4, replace=False)
        H = compute_homography(src_pts[indices], dst_pts[indices])

        # Compute inliers
        src_homo = np.hstack((src_pts.reshape(-1, 2), np.ones((num_points, 1))))
        projected_pts = (H @ src_homo.T).T
        projected_pts /= projected_pts[:, 2].reshape(-1, 1)

        errors = np.linalg.norm(projected_pts[:, :2] - dst_pts.reshape(-1, 2), axis=1)
        num_inliers = np.sum(errors < threshold)

        if num_inliers > best_inliers:
            best_H = H
            best_inliers = num_inliers

    return best_H

# Main function
if len(sys.argv) != 3:
    print("Usage: python prog1.py <image_directory> <output_image>")
    sys.exit(1)

# Arguments
image_dir = sys.argv[1]
output_image = sys.argv[2]

# Load images except "mosaic.jpg"
image_files = sorted([f for f in os.listdir(image_dir) if f.lower().endswith(('.jpg', '.png', '.jpeg')) and f.lower() != "mosaic.jpg"])

if len(image_files) < 2:
    print("Error: Less than two images found in the directory (excluding 'mosaic.jpg').")
    sys.exit(1)

# First image as base of panorama
panorama = cv2.imread(os.path.join(image_dir, image_files[0]))

if panorama is None:
    print(f"Error: Unable to load {image_files[0]}")
    sys.exit(1)

original_height = panorama.shape[0]  # Store the original height for resizing

# Resize factor
resize_factor = 0.5

for i in range(1, len(image_files)):
    img_path = os.path.join(image_dir, image_files[i])
    img = cv2.imread(img_path)

    if img is None:
        print(f"Skipping {image_files[i]} (unable to load).")
        continue

    print(f"Processing: {image_files[i]}")

    # Resize image
    img_resized = cv2.resize(img, (int(img.shape[1] * resize_factor), int(img.shape[0] * resize_factor)))
    
    # Keypoint detection and matching
    gray1 = cv2.cvtColor(panorama, cv2.COLOR_BGR2GRAY)
    gray2 = cv2.cvtColor(img_resized, cv2.COLOR_BGR2GRAY)

    # Detect keypoints and compute descriptors
    sift = cv2.SIFT_create()
    kp1, des1 = sift.detectAndCompute(gray1, None)
    kp2, des2 = sift.detectAndCompute(gray2, None)

    # Match keypoints using Brute-Force Matcher with kNN
    bf = cv2.BFMatcher()
    matches = bf.knnMatch(des1, des2, k=2)

    # Apply Lowe's ratio test
    good_matches = [m for m, n in matches if m.distance < 0.75 * n.distance]

    print(f"Found {len(good_matches)} good matches.")

    if len(good_matches) >= 4:
        # Extract matched keypoints
        src_pts = np.float32([kp1[m.queryIdx].pt for m in good_matches]).reshape(-1, 1, 2)
        dst_pts = np.float32([kp2[m.trainIdx].pt for m in good_matches]).reshape(-1, 1, 2)

        # Compute homography using RANSAC
        H = compute_homography_ransac(src_pts, dst_pts, threshold=5.0, max_iters=2000)

        if H is not None:
            # Base panorama size
            height_pano, width_pano, _ = panorama.shape
            height_img, width_img, _ = img_resized.shape

            # Warp current panorama to fit
            warped_pano = cv2.warpPerspective(panorama, H, (width_pano + width_img, height_pano))

            # Overlay new image
            warped_pano[0:height_img, 0:width_img] = img_resized

            # Update panorama
            panorama = warped_pano
        else:
            print(f"Skipping {image_files[i]} (homography computation failed).")
    else:
        print(f"Skipping {image_files[i]} (not enough good matches).")

# Trim black borders
gray_panorama = cv2.cvtColor(panorama, cv2.COLOR_BGR2GRAY)
_, thresh = cv2.threshold(gray_panorama, 1, 255, cv2.THRESH_BINARY)

coords = cv2.findNonZero(thresh)  # Find non-zero regions
x, y, w, h = cv2.boundingRect(coords)  # Get bounding box
panorama = panorama[y:y+h, x:x+w]  # Crop image to remove black regions

# Resize back to the original height
aspect_ratio = original_height / panorama.shape[0]
new_width = int(panorama.shape[1] * aspect_ratio)
resized_panorama = cv2.resize(panorama, (new_width, original_height), interpolation=cv2.INTER_AREA)

# Fit paranorma to canvas
height, width, _ = panorama.shape
stretched_panorama = cv2.resize(panorama, (width, height), interpolation=cv2.INTER_CUBIC)

# Save final stitched panorama
cv2.imwrite(output_image, stretched_panorama)
print(f"Final Panorama: {output_image}")
